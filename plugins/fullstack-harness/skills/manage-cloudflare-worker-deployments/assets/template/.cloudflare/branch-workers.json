{
  "workerPrefix": "replace-me-preview",
  "protectedBranches": ["main"],
  "protectedWorkers": ["replace-me", "replace-me-production"],
  "maxWorkerNameLength": 48,
  "workersDevSubdomain": "replace-me",
  "install": {
    "command": ["npm", "ci"],
    "cwd": "."
  },
  "verify": {
    "command": ["npm", "test"],
    "cwd": "."
  },
  "build": {
    "command": ["npm", "run", "build"],
    "cwd": "."
  },
  "wrangler": {
    "command": ["npx", "wrangler"],
    "cwd": ".",
    "environment": "development",
    "config": null
  },
  "production": null,
  "afterDeploy": null,
  "delete": {
    "force": false
  }
}
