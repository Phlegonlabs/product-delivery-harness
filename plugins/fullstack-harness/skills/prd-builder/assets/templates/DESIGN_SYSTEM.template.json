{
  "schema": "design-system/1",
  "product": "<product name>",
  "platform": "<web | ios | android | flutter | react-native | macos | windows | desktop>",
  "stylingMechanism": "<utility CSS | CSS-in-JS | CSS modules | plain CSS | platform theme>",
  "enforcement": "<blocking | advisory>",

  "$comment:sources": "tokenSources are the only paths where a raw color, dimension, or motion value may appear. primitiveSources are the paths whose job is defining control and surface selectors, so page-local-control-style is not reported for them. Both are matched as path suffixes against each checked file.",
  "tokenSources": [
    "<path to the file that declares the token values, e.g. src/styles/tokens.css>"
  ],
  "primitiveSources": [
    "<path to the file that defines primitive classes, e.g. src/ui/primitives.css>"
  ],

  "$comment:responsive": "Ship exactly one of viewports or sizeClasses. Use viewports for a web target. For a native or desktop target, delete viewports and ship sizeClasses instead with that platform's own model. Shipping both, neither, or an empty set is an error.",
  "viewports": [390, 768, 1200, 1440],

  "tokens": {
    "color": {
      "<--bg>": "<value>",
      "<--surface>": "<value>",
      "<--text>": "<value>",
      "<--border>": "<value>",
      "<--accent>": "<value>",
      "<--success>": "<value>",
      "<--warning>": "<value>",
      "<--danger>": "<value>"
    },
    "space": { "<--space-1>": "<value>", "<--space-2>": "<value>", "<--space-4>": "<value>" },
    "radius": { "<--radius-sm>": "<value>", "<--radius-md>": "<value>", "<--radius-lg>": "<value>" },
    "fontSize": { "<--text-body>": "<value>", "<--text-heading>": "<value>", "<--text-display>": "<value>" },
    "lineHeight": { "<--leading-body>": "<value>", "<--leading-heading>": "<value>" },
    "shadow": { "<--shadow-raised>": "<value>", "<--shadow-overlay>": "<value>" },
    "duration": { "<--duration-fast>": "<value>", "<--duration-base>": "<value>" },
    "easing": { "<--ease-standard>": "<value>" }
  },

  "$comment:primitives": "Four layers: layout, surface, typography, control. Every variant list is a closed set — a page picks from it and may not extend it. 'class' is the base class name when it differs from the kebab-cased primitive name.",
  "primitives": {
    "Container": {
      "layer": "layout",
      "sizes": ["shell", "content", "narrow", "dialog"],
      "defaults": { "sizes": "content" }
    },
    "Section": {
      "layer": "layout",
      "densities": ["compact", "default", "editorial"],
      "defaults": { "densities": "default" }
    },
    "Stack": {
      "layer": "layout",
      "gaps": ["1", "2", "3", "4", "5", "6", "8", "12"]
    },
    "Cluster": {
      "layer": "layout",
      "gaps": ["1", "2", "3", "4", "5", "6"],
      "aligns": ["start", "center", "end", "baseline"]
    },
    "Grid": {
      "layer": "layout",
      "columns": ["2", "3", "4"],
      "gaps": ["1", "2", "3", "4", "5", "6", "8"]
    },
    "Surface": {
      "layer": "surface",
      "variants": ["plain", "raised", "inset", "selected", "warning", "danger"]
    },
    "Divider": {
      "layer": "surface"
    },
    "Text": {
      "layer": "typography",
      "roles": ["display", "heading", "body", "caption"],
      "truncation": ["truncate", "clamp"]
    },
    "Button": {
      "layer": "control",
      "class": "btn",
      "variants": ["primary", "secondary", "tertiary", "danger"],
      "sizes": ["sm", "md", "lg"],
      "defaults": { "variants": "primary", "sizes": "md" },
      "minTargetPx": 44
    },
    "IconButton": {
      "layer": "control",
      "class": "btn-icon",
      "variants": ["default"],
      "sizes": ["sm", "md", "lg"],
      "defaults": { "variants": "default", "sizes": "md" },
      "minTargetPx": 44,
      "requiresAccessibleName": true
    }
  },

  "productComponents": {
    "<DomainComponentName>": {
      "dsId": "DS-COMP-001",
      "requiredContentOrder": ["<field>", "<field>", "<field>"],
      "composes": ["<DS-LAY-001>", "<DS-SUR-001>", "<DS-CTL-001>"],
      "states": ["ready", "loading", "empty", "error"]
    }
  },

  "motionVariants": ["<variant name>", "<variant name>"],

  "stateMatrix": [
    "ready",
    "loading",
    "empty",
    "error",
    "disabled",
    "permission-denied",
    "stale",
    "expired",
    "long-content",
    "reduced-motion",
    "mobile-reflow"
  ]
}
